{
  "name": "d3-eazy",
  "version": "1.0.0",
  "description": "Reusable D3 charts with chained setters and the general update pattern",
  "main": "d3-eazy.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "check": "npm run lint && npm test && npm run build"
  },
  "author": "Shaun Pearce",
  "license": "BSD-2-Clause",
  "dependencies": {
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "0.23.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0"
  },
  "type": "module",
  "exports": {
    ".": "./d3-eazy.js"
  },
  "files": [
    "d3-eazy.js",
    "chart-kit.js",
    "charts-classic.js",
    "charts-more.js",
    "features.js",
    "events.js",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "d3",
    "charts",
    "data-visualization",
    "svg",
    "reusable-charts"
  ]
}
